PORT=4100
NODE_ENV=development

# Signs login tokens. Change this to any long random string before deploying.
JWT_SECRET=change-me-to-something-long-and-random

# Where the SQLite file lives. Delete it and run `npm run db:reset` to start over.
DATABASE_FILE=./data/stride.db

ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# --- Photographs -----------------------------------------------------------
UPLOAD_DIR=./data/uploads
PUBLIC_URL=http://localhost:4100

# --- Listing generator -----------------------------------------------------
# Leave AI_API_KEY empty and the generator uses its local writer: real copy from
# your typed facts, no photograph analysis, clearly labelled in the interface.
# Add a key and the same pipeline runs against a vision model.
AI_PROVIDER=openai
AI_API_KEY=
